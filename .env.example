# ---- Public address ------------------------------------------------------------
# Domain for automatic HTTPS, e.g. angebot.musterfertigung.de  (":80" = plain HTTP for LAN tests)
SITE_ADDRESS=localhost
QUOTE_CORS_ORIGINS=["https://localhost"]

# ---- AI engine (optional - without a key the deterministic rules engine answers) ----
ANTHROPIC_API_KEY=
# auto | off | required
QUOTE_AI_MODE=auto
QUOTE_ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
QUOTE_ANTHROPIC_EFFORT=medium

# ---- Integration API (ERP/MES: /api/v1/engine/evaluate, /api/v1/factory) ---------
# Generate with:  openssl rand -hex 32
QUOTE_ADMIN_API_KEY=

# ---- Costing defaults (live values are managed via PUT /api/v1/factory) ----------
QUOTE_RATE_CNC_3_AXIS_EUR_H=85
QUOTE_RATE_CNC_5_AXIS_EUR_H=110
QUOTE_RATE_LATHE_EUR_H=75
QUOTE_DEFAULT_ENERGY_SURCHARGE_PERCENT=4
QUOTE_DEFAULT_TARGET_MARGIN_PERCENT=15
QUOTE_DEFAULT_BACKLOG_DAYS=3
# stock (raw blank, recommended) | part (original contract formula, underprices pockets/blades)
QUOTE_MATERIAL_BASIS=stock
# markup (Gewinnzuschlag) | margin (share of price)
QUOTE_MARGIN_MODE=markup

# ---- Accounts & payments (plans/prices live in backend/app/billing/plans.py) -------
# Public URL of the web app (Stripe redirects back here)
QUOTE_PUBLIC_APP_URL=https://localhost
# Stripe TEST keys first (sk_test_..., whsec_...). Without a key, non-production
# instances unlock paid plans without payment (demo mode); production refuses checkout.
QUOTE_STRIPE_SECRET_KEY=
QUOTE_STRIPE_WEBHOOK_SECRET=
# true once Stripe Tax is activated (adds 19 % MwSt on invoices)
QUOTE_STRIPE_AUTOMATIC_TAX=false

# ---- Supplier master data printed on every quote (§ 35a GmbHG) -------------------
QUOTE_COMPANY_NAME=Musterfertigung GmbH
QUOTE_COMPANY_STREET=Industriestraße 1
QUOTE_COMPANY_CITY=38440 Wolfsburg
QUOTE_COMPANY_COUNTRY=Deutschland
QUOTE_COMPANY_EMAIL=angebote@musterfertigung.example
QUOTE_COMPANY_PHONE=+49 5361 000000
QUOTE_COMPANY_VAT_ID=DE000000000
QUOTE_COMPANY_REGISTER=Amtsgericht Braunschweig HRB 000000
QUOTE_COMPANY_MANAGING_DIRECTOR=Max Mustermann

# ---- Operations -------------------------------------------------------------------
QUOTE_QUOTE_RETENTION_DAYS=90
QUOTE_MAX_UPLOAD_MB=25
QUOTE_RATE_LIMIT_PER_WINDOW=20
QUOTE_RATE_LIMIT_WINDOW_S=600
WEB_CONCURRENCY=2
